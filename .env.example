# FloodGuard Thailand - Environment Variables
# Copy this file to .env and fill in your values

# Django
SECRET_KEY=change-me-to-a-strong-random-key-in-production
DEBUG=False
ALLOWED_HOSTS=localhost 127.0.0.1 0.0.0.0

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# ===== Thai API Keys =====

# กรมอุตุนิยมวิทยา (TMD) - Register at: http://data.tmd.go.th/api/index1.php
TMD_API_UID=
TMD_API_UKEY=

# GISTDA Flood API - Register at: https://api-gateway.gistda.or.th/v2
GISTDA_API_KEY=

# ===== Notes =====
# Open-Meteo (พยากรณ์ฝน) - ฟรี ไม่ต้องมี API Key
# RID Dam API (กรมชลประทาน) - ฟรี ไม่ต้องมี API Key
